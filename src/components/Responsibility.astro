---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.responsibility;
const points = r.points ?? [];
---

<section id="responsibility" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{r.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{r.subtitle}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {points.map((p) => (
        <article class="rounded-2xl p-6 border h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-xl flex items-center justify-center text-xl" style="background: color-mix(in srgb, var(--accent) 14%, transparent);" aria-hidden="true">{p.icon}</span>
            <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{p.title}</h3>
          </div>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{p.text}</p>
        </article>
      ))}
    </div>

    {r.footnote && (
      <p class="text-center text-sm mt-8 leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">{r.footnote}</p>
    )}
  </div>
</section>
