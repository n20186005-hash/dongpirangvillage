---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.stories;
const items = s.items ?? [];
---

<section id="stories" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{s.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    </div>

    <div class="space-y-6">
      {items.map((item) => (
        <article class="rounded-2xl p-6 md:p-8 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-start gap-4">
            <span class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center text-xl" style="background: color-mix(in srgb, var(--accent) 14%, transparent);" aria-hidden="true">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-lg mb-2" style="color: var(--text-primary);">{item.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
