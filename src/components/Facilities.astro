---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.facilities;
const categories = f.categories ?? [];
---

<section id="services" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{f.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{f.subtitle}</p>
    </div>

    <div class="rounded-2xl p-5 mb-8 border text-sm" style="background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, transparent); color: var(--text-secondary);">
      {f.disclaimer}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map((cat) => (
        <article class="rounded-2xl p-6 border h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-xl flex items-center justify-center text-xl" style="background: color-mix(in srgb, var(--accent) 14%, transparent);" aria-hidden="true">{cat.icon}</span>
            <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{cat.title}</h3>
          </div>
          <p class="text-sm leading-relaxed mb-3" style="color: var(--text-secondary);">{cat.text}</p>
          {cat.tip && (
            <p class="text-xs leading-relaxed px-3 py-2 rounded-lg border-l-4" style="background: var(--bg-tertiary); border-color: var(--accent); color: var(--text-muted);">{cat.tip}</p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
