---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.sources;
const links = messages.footer?.officialLinksList ?? [];
---

<section id="sources" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{s.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8 leading-relaxed" style="color: var(--text-secondary);">{s.intro}</p>

    <ul class="grid sm:grid-cols-2 gap-3 max-w-3xl mx-auto">
      {links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-2xl border px-4 py-3 text-sm font-medium transition hover:opacity-80"
            style="border-color: var(--border-color); color: var(--accent); background: var(--bg-primary);"
          >
            <span aria-hidden="true">🔗</span>
            <span class="break-words">{link.name} ↗</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="text-center text-xs mt-8 leading-relaxed" style="color: var(--text-muted);">
      {messages.footer?.disclaimer}
    </p>
  </div>
</section>
