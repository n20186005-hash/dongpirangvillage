---
import { getI18n } from '../i18n/ui';
import { tongyeongContent } from '../data/tongyeong';

const { lang, messages } = getI18n(Astro.url);
const content = tongyeongContent[lang];
const url = `/${lang}/tongyeong-attractions/`;
const label = `${messages.header.tongyeong} →`;
---

<section class="section-padding" style="background: var(--bg-tertiary);">
  <div class="max-w-4xl mx-auto px-4">
    <div class="rounded-2xl p-6 sm:p-8 border" style="background: var(--card-bg); border-color: var(--border-color);">
      <p class="text-xs uppercase tracking-[0.18em] mb-2" style="color: var(--accent);">{messages.header.tongyeong}</p>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold mb-2" style="color: var(--text-primary);">{content.h1}</h2>
      <p class="text-base leading-relaxed mb-5" style="color: var(--text-secondary);">{content.subtitle}</p>
      <a href={url} class="inline-flex justify-center px-7 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">{label}</a>
    </div>
  </div>
</section>
